{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryna",
  "identifier": "io.ryna.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ryna",
        "width": 820,
        "height": 560,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MaddisonM79/ryna_agent/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "category": "Utility",
    "shortDescription": "The World of Warcraft: Forever companion: syncs your characters to ryna.io while it is open.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../cores/wow/addon/Ryna/*": "addon/Ryna/",
      "../../../mods/wow/chronicle/addon/Ryna_Chronicle/*": "addon/Ryna_Chronicle/",
      "../../../mods/wow/automation/addon/Ryna_Automation/*": "addon/Ryna_Automation/",
      "../../../mods/wow/prices/addon/Ryna_Prices/*": "addon/Ryna_Prices/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
