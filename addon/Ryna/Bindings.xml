<!-- Ryna's key binding: Key Bindings -> AddOns -> Ryna -> Next census query. The game loads this
     file from the addon's folder by itself (it isn't listed in Ryna.toc). The header and name are
     the BINDING_HEADER_RYNA and BINDING_NAME_RYNA_CENSUS_NEXT globals, set in Slash.lua. The body
     runs inside the key press, which is what lets it send /who on clients that allow it only from
     a hardware event. -->
<Bindings>
  <Binding name="RYNA_CENSUS_NEXT" header="RYNA" category="ADDONS">
    Ryna_CensusNext()
  </Binding>
</Bindings>
