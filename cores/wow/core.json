{
  "id": "wow",
  "name": "World of Warcraft: Forever",
  "version": "0.3.8",
  "runtime": { "kind": "builtin" },
  "resource": "https://api.ryna.io/wow/ingest",
  "scopes": ["wow:ingest"],
  "detect": {
    "folders": [
      "/Applications/World of Warcraft",
      "~/Applications/World of Warcraft",
      "C:\\Program Files (x86)\\World of Warcraft",
      "C:\\Program Files\\World of Warcraft",
      "~/.wine/drive_c/Program Files (x86)/World of Warcraft",
      "~/.wine/drive_c/Program Files/World of Warcraft",
      "~/Games/*/drive_c/Program Files (x86)/World of Warcraft",
      "~/Games/*/drive_c/Program Files/World of Warcraft",
      "~/.var/app/com.usebottles.bottles/data/bottles/bottles/*/drive_c/Program Files (x86)/World of Warcraft",
      "~/.var/app/com.usebottles.bottles/data/bottles/bottles/*/drive_c/Program Files/World of Warcraft",
      "~/.local/share/bottles/bottles/*/drive_c/Program Files (x86)/World of Warcraft",
      "~/.local/share/bottles/bottles/*/drive_c/Program Files/World of Warcraft",
      "~/.steam/steam/steamapps/compatdata/*/pfx/drive_c/Program Files (x86)/World of Warcraft",
      "~/.steam/steam/steamapps/compatdata/*/pfx/drive_c/Program Files/World of Warcraft",
      "~/.local/share/Steam/steamapps/compatdata/*/pfx/drive_c/Program Files (x86)/World of Warcraft",
      "~/.local/share/Steam/steamapps/compatdata/*/pfx/drive_c/Program Files/World of Warcraft",
      "~/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/compatdata/*/pfx/drive_c/Program Files (x86)/World of Warcraft",
      "~/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/compatdata/*/pfx/drive_c/Program Files/World of Warcraft"
    ]
  },
  "data": {
    "reads": [
      ".flavor.info",
      "WTF/Account/*/SavedVariables/Ryna.lua",
      "Logs/WoWCombatLog-*.txt",
      "Interface/AddOns/Ryna/Ryna.toc",
      "Interface/AddOns/Ryna_*/Ryna_*.toc",
      "WTF/Account/*/AddOns.txt",
      "WTF/Account/*/*/*/AddOns.txt",
      "Interface/AddOns/*/*.toc",
      "WTF/Account/*/SavedVariables/*.lua",
      "WTF/Account/*/*/*/SavedVariables/*.lua",
      "WTF/Account/*/*/*/config-cache.wtf",
      "WTF/Account/*/*/*/bindings-cache.wtf",
      "WTF/Account/*/*/*/macros-cache.txt",
      "WTF/Account/*/*/*/chat-cache.txt",
      "WTF/Account/*/*/*/layout-local.txt"
    ],
    "writes": [
      "Interface/AddOns/Ryna/",
      "Interface/AddOns/Ryna_*/",
      "WTF/Account/*/SavedVariables/*.lua",
      "WTF/Account/*/*/*/SavedVariables/*.lua",
      "WTF/Account/*/*/*/config-cache.wtf",
      "WTF/Account/*/*/*/bindings-cache.wtf",
      "WTF/Account/*/*/*/macros-cache.txt",
      "WTF/Account/*/*/*/chat-cache.txt",
      "WTF/Account/*/*/*/layout-local.txt",
      "WTF/Account/*/*/*/AddOns.txt"
    ]
  },
  "mods": "mods/wow"
}
