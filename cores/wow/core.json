{
  "id": "wow",
  "name": "World of Warcraft: Forever",
  "version": "0.3.0",
  "runtime": { "kind": "builtin" },
  "resource": "https://api.ryna.io/wow/ingest",
  "scopes": ["wow:ingest"],
  "detect": {
    "folders": [
      "/Applications/World of Warcraft",
      "~/Applications/World of Warcraft",
      "C:\\Program Files (x86)\\World of Warcraft",
      "C:\\Program Files\\World of Warcraft"
    ]
  },
  "data": {
    "reads": [
      ".flavor.info",
      "WTF/Account/*/SavedVariables/Ryna.lua",
      "Logs/WoWCombatLog-*.txt",
      "Interface/AddOns/Ryna/Ryna.toc",
      "Interface/AddOns/Ryna_*/Ryna_*.toc",
      "WTF/Account/*/AddOns.txt",
      "WTF/Account/*/*/*/AddOns.txt"
    ],
    "writes": [
      "Interface/AddOns/Ryna/",
      "Interface/AddOns/Ryna_*/"
    ]
  },
  "mods": "mods/wow"
}
